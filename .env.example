# Spira MCP server configuration.
#
# The server reads these from its process environment. Normally you set them
# in the "env" block of your MCP client's server config (see README.md), not
# in a checked-in file. Copy this to .env only if you load it yourself, and
# never commit the real file.

# Your Spira URL, no trailing slash. SaaS looks like:
SPIRA_BASE_URL=https://yourcompany.spiraservice.net

# Your Spira username (use your own, not a shared account).
SPIRA_USERNAME=your.username

# Your API key: Spira -> My Profile -> API Key. Grants whatever access your
# Spira user has. Keep it secret.
SPIRA_API_KEY=your-api-key-here

# Optional. REST API version segment. Default: v6_0
SPIRA_API_VERSION=v6_0

# Optional. Project used when a tool call doesn't pass project_id. The id is
# the number in the project URL (e.g. .../PR3/... -> 3).
SPIRA_DEFAULT_PROJECT_ID=1

# Optional. HTTP timeout in seconds. Default: 30
SPIRA_TIMEOUT=30
